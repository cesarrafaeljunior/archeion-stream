PUID=1000
PGID=1000
# Diretorio de midia do Archeion Stream no host. Prefira uma montagem fixa via UUID.
MEDIA_ROOT=/mnt/archeion-stream-media
MEDIA_UUID=UUID_DO_DISCO
# Biblioteca sincronizada/montada no host.
MEDIA_DRIVE_ROOT=/mnt/google-drive

# Por padrao, a interface fica acessivel apenas no proprio host.
# Para acesso privado direto, use o IP Tailscale do servidor (100.x.y.z).
JELLYFIN_BIND_ADDRESS=127.0.0.1

# Descoberta UDP deve permanecer local, exceto quando a LAN realmente precisar dela.
JELLYFIN_DISCOVERY_BIND_ADDRESS=127.0.0.1
